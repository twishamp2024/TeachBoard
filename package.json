{
  "name": "teachboard",
  "productName": "TeachBoard",
  "version": "1.0.0",
  "description": "An offline whiteboard and digital teaching application for Windows and macOS.",
  "author": "TeachBoard Contributors",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "icons": "node scripts/make-icons.mjs",
    "sync-config": "node scripts/sync-app-config.mjs",
    "dist:win": "npm run sync-config && npm run build && electron-builder --win --publish never --config electron-builder.config.cjs && node scripts/collect-release.mjs win",
    "dist:mac": "npm run sync-config && npm run build && electron-builder --mac --publish never --config electron-builder.config.cjs && node scripts/collect-release.mjs mac",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "fflate": "0.8.3",
    "immer": "11.1.21",
    "lucide-react": "1.58.0",
    "mathjax-full": "3.2.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "perfect-freehand": "1.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  }
}
