; Generated by scripts/sync-app-config.mjs from app.config.json — do not edit.
!macro customUnInstall
  ReadRegStr $0 SHCTX "Software\Classes\.tboard" ""
  ${If} $0 == "TeachBoard Lesson"
    DeleteRegKey SHCTX "Software\Classes\.tboard"
    System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
  ${EndIf}
!macroend
